<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Mobilisten</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Allow access to Bluetooth so you can use a Bluetooth headset during audio and video calls in chat support.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Allow access to Bluetooth so you can use a Bluetooth headset during audio and video calls in chat support.</string>
	<key>NSCameraUsageDescription</key>
	<string>Allow access to your camera so you can share photos and make video calls with support agents in chat.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Allow access to your location so you can share it with support agents when you need location-based help in chat.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Allow access to your microphone so you can send voice messages and make audio and video calls with support agents in chat.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Allow access to your photo library so you can save photos and files shared by support agents in chat.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Allow access to your photo library so you can share photos and files with support agents in chat.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>SIQPushMode</key>
	<string>js</string>
	<key>UIAppFonts</key>
	<array>
		<string>MaterialCommunityIcons.ttf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
