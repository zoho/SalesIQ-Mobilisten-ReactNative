{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["react-native", "jest"]
  },
  "include": [
    "App.tsx",
    "index.js",
    "components/**/*",
    "constants/**/*",
    "navigation/**/*",
    "screens/**/*",
    "scripts/**/*",
    "state/**/*",
    "theme/**/*"
  ],
  "exclude": ["node_modules"]
}
